# --- Infrastructure (host ports; docker-compose overrides these inside containers)
DATABASE_URL=postgresql://droppilot:droppilot@localhost:5433/droppilot
REDIS_URL=redis://localhost:6379

# --- Admin login (single user). Generate the hash with: npm run auth:hash -- '<password>'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Mock mode: true runs the whole pipeline on built-in fake data, no keys needed
MOCK_APIS=true

# --- Supplier
CJ_API_KEY=
# true = CJ orders are sandbox orders (never charged or shipped). Set false to place real orders.
CJ_SANDBOX_ORDERS=true

# --- eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENV=sandbox
# Production only: the public https address of /api/ebay/account-deletion and the 32-80 character
# token registered with it at developer.ebay.com (Alerts & Notifications). See README, "Going to production".
EBAY_DELETION_ENDPOINT=
EBAY_VERIFICATION_TOKEN=

# --- Amazon SP-API
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
# na, eu or fe
SPAPI_REGION=na
# Seller (merchant) ID from Seller Central > Account Info
SPAPI_SELLER_ID=

# --- Data sources
KEEPA_API_KEY=
SERPAPI_KEY=
# Who answers the AI questions (specs, photo checks, listing text):
#   anthropic-api = the Anthropic API with ANTHROPIC_API_KEY (billed per call)
#   claude-cli    = the locally installed, signed-in `claude` command (uses your Claude subscription)
AI_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=
# Jina AI API key (jina-clip-v2 image embeddings)
EMBEDDINGS_PROVIDER_KEY=

# --- Alerts
# A URL that accepts POST {"text": "..."}; for a Telegram bot:
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat id>
TELEGRAM_WEBHOOK_URL=
# Alert emails: SMTP connection URL (smtps://user:password@smtp.example.com:465) and the address to notify
SMTP_URL=
ALERT_EMAIL_TO=

# --- Initial defaults in dollars (afterwards editable in Settings)
MIN_PROFIT=3.00
MAX_ACCEPTABLE_LOSS=1.00
DEMAND_THRESHOLD=60
