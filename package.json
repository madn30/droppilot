{
  "name": "droppilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "match": "tsx --env-file-if-exists=.env scripts/match-product.ts",
    "check:live": "tsx --env-file-if-exists=.env scripts/check-live.ts",
    "ebay:token": "tsx --env-file-if-exists=.env scripts/ebay-token.ts",
    "try:supplier": "tsx --env-file-if-exists=.env scripts/try-supplier.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "next": "15.5.27",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  }
}
